#!/bin/bash
set -u

VICKY_DIR="${VICKY_DIR:-/home/gerd/vicky8}"
AWTRIX_UID="${AWTRIX_UID:-awtrix_3e6014}"
MQTT_HOST="${MQTT_HOST:-localhost}"
LANGUAGE_STATE_TOPIC="${LANGUAGE_STATE_TOPIC:-vicky/state/language}"
LANGUAGE_DISCOVERY_TOPIC="${LANGUAGE_DISCOVERY_TOPIC:-homeassistant/sensor/vicky_language/config}"

publish_language_state() {
    lang="$1"

    /usr/bin/mosquitto_pub -h "$MQTT_HOST" -r \
      -t "$LANGUAGE_DISCOVERY_TOPIC" \
      -m "{\"name\":\"Vicky Language\",\"unique_id\":\"vicky_language\",\"state_topic\":\"$LANGUAGE_STATE_TOPIC\",\"icon\":\"mdi:translate\"}"

    /usr/bin/mosquitto_pub -h "$MQTT_HOST" -r \
      -t "$LANGUAGE_STATE_TOPIC" \
      -m "$lang"
}

# Publish the already selected language at service start so Home Assistant and
# every Vicky component share one persistent language state.
if cd "$VICKY_DIR" 2>/dev/null; then
    current_lang=$(/usr/bin/python3 -c 'from language_state import load_output_language; print(load_output_language())' 2>/dev/null || true)
    case "$current_lang" in
        fr|de|en) publish_language_state "$current_lang" ;;
    esac
fi

/usr/bin/mosquitto_sub \
  -h "$MQTT_HOST" \
  -v \
  -t "$AWTRIX_UID/stats/buttonLeft" \
  -t "$AWTRIX_UID/stats/buttonRight" |
while read -r topic value
do
    if [ "$value" != "1" ]; then
        continue
    fi

    case "$topic" in
        "$AWTRIX_UID/stats/buttonLeft")
            touch /tmp/vicky-news-force-refresh
            ;;

        "$AWTRIX_UID/stats/buttonRight")
            cd "$VICKY_DIR" || continue
            lang=$(/usr/bin/python3 -c 'from language_state import cycle_output_language; print(cycle_output_language())')
            echo "Vicky language switched to: $lang"

            publish_language_state "$lang"

            case "$lang" in
                fr) label="FRANÇAIS" ;;
                de) label="DEUTSCH" ;;
                en) label="ENGLISH" ;;
                *)  label="$lang" ;;
            esac

            /usr/bin/mosquitto_pub -h "$MQTT_HOST" \
              -t "$AWTRIX_UID/notify" \
              -m "{\"text\":\"SPRACHE: $label\",\"duration\":3}"

            touch /tmp/vicky-news-force-refresh
            ;;
    esac
done
