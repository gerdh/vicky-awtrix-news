[Unit]
Description=Vicky V8 AWTRIX News Service
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=gerd
WorkingDirectory=/home/gerd/vicky8
ExecStart=/home/gerd/vicky8/.venv/bin/python /home/gerd/vicky8/awtrix_news_vicki.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
